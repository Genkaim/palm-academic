{
  "schemaVersion": 1,
  "id": "genkaim-top",
  "name": "genkaim.top 测试学校",
  "author": {
    "name": "Genkaim",
    "email": "genkaim@outlook.com"
  },
  "baseUrl": "https://portal.cupk.edu.cn/portal",
  "readerAdapter": "adapters/genkaim-top-reader.js",
  "auth": {
    "type": "engine",
    "loginUrl": "https://cas.cupk.edu.cn/cas/login",
    "successUrlPrefixes": [
      "https://portal.cupk.edu.cn/portal/"
    ],
    "sessionCookieHosts": [
      "portal.cupk.edu.cn",
      "cas.cupk.edu.cn"
    ],
    "sessionCookieNames": [],
    "engine": {
      "steps": [
        {
          "id": "loginPage",
          "request": {
            "method": "GET",
            "url": "{loginUrl}",
            "headers": {
              "Accept": "text/html,application/xhtml+xml",
              "Accept-Language": "zh-CN,zh;q=0.9"
            }
          }
        },
        {
          "id": "execution",
          "extract": {
            "regex": "name=\"execution\" value=\"([^\"]+)\""
          }
        },
        {
          "id": "encryptedPassword",
          "transform": {
            "algorithm": "rsa-pkcs1-base64",
            "publicKey": "MFswDQYJKoZIhvcNAQEBBQADSgAwRwJAUpCfX4kq+mbPNcVHM9x1OIwk94OaU4Dwt0gS0VHDM52pG60Fmxjm47DP5EXIgrg1UlMSwJbBIdHyg1XS1E3OjQIDAQAB",
            "input": "{password}"
          }
        },
        {
          "id": "loginPost",
          "request": {
            "method": "POST",
            "url": "{loginUrl}",
            "headers": {
              "Referer": "{loginUrl}",
              "Accept": "text/html,application/xhtml+xml",
              "Accept-Language": "zh-CN,zh;q=0.9"
            },
            "contentType": "form",
            "form": {
              "username": "{username}",
              "password": "{encryptedPassword}",
              "execution": "{execution}",
              "_eventId": "submit"
            }
          }
        }
      ],
      "outcome": {
        "rejected": {
          "statusCodes": [401],
          "bodyContains": ["Invalid credentials."],
          "message": "账号或密码错误"
        },
        "success": {
          "finalUrlPrefixes": ["https://portal.cupk.edu.cn/"]
        }
      }
    }
  },
  "monitor": {
    "coursePagePath": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME",
    "courseDataPathTemplate": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&view={semesterId}",
    "gradeDataPathTemplate": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME",
    "examDataPathTemplate": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME",
    "semesterIdPatterns": [
      "cmd=([A-Z_]+)"
    ],
    "studentIdPatterns": [
      "id=\"userName\"[^>]*>\\s*([^<\\s]+)"
    ]
  },
  "groups": [
    {
      "title": "门户功能",
      "items": [
        {
          "title": "融合门户首页",
          "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME"
        },
        {
          "title": "服务大厅",
          "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=com.awspaas.user.apps.cupk.theme.v3_to_service_hall"
        }
      ]
    },
    {
      "title": "重绘演示（登录后首页数据）",
      "items": [
        {
          "title": "任务概览",
          "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=schedule#pa-schedule",
          "quick": true,
          "nativeType": "schedule"
        },
        {
          "title": "应用系统",
          "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=grade#pa-grade",
          "quick": true,
          "nativeType": "grade"
        },
        {
          "title": "网上服务",
          "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=exam#pa-exam",
          "quick": true,
          "nativeType": "exam"
        },
        {
          "title": "常用服务",
          "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=program#pa-program",
          "quick": true,
          "nativeType": "program"
        }
      ]
    }
  ],
  "readerConfig": {
    "scheduleProfiles": [
      {
        "locationPattern": "",
        "unitTimes": {
          "1": ["08:00", "08:45"],
          "2": ["08:50", "09:35"],
          "3": ["10:00", "10:45"]
        }
      }
    ]
  }
}
