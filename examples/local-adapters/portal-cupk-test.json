{
  "schemaVersion": 1,
  "id": "portal-cupk-test",
  "name": "CUPK 融合门户（验证码测试）",
  "author": {
    "name": "Genkaim",
    "email": "genkaim@outlook.com"
  },
  "baseUrl": "https://portal.cupk.edu.cn/portal",
  "readerAdapter": "adapters/portal-cupk-test-reader.js",
  "auth": {
    "type": "engine",
    "loginUrl": "https://cas.cupk.edu.cn/cas/login?service=https%3A%2F%2Fportal.cupk.edu.cn%2Fportal%2F",
    "successUrlPrefixes": [
      "https://portal.cupk.edu.cn/portal/"
    ],
    "sessionCookieHosts": [
      "portal.cupk.edu.cn",
      "cas.cupk.edu.cn"
    ],
    "sessionCookieNames": [],
    "captcha": {
      "required": true,
      "imageUrl": "https://cas.cupk.edu.cn/cas/captcha.jpg",
      "refreshQueryParameter": "id"
    },
    "engine": {
      "steps": [
        {
          "id": "loginPage",
          "request": {
            "method": "GET",
            "url": "{loginUrl}",
            "headers": {
              "Accept": "text/html,application/xhtml+xml",
              "Accept-Language": "zh-CN,zh;q=0.9"
            }
          }
        },
        {
          "id": "execution",
          "extract": {
            "from": "loginPage",
            "regex": "name=\"execution\" value=\"([^\"]+)\""
          }
        },
        {
          "id": "encryptedPassword",
          "transform": {
            "algorithm": "rsa-pkcs1-base64",
            "publicKey": "MFswDQYJKoZIhvcNAQEBBQADSgAwRwJAUpCfX4kq+mbPNcVHM9x1OIwk94OaU4Dwt0gS0VHDM52pG60Fmxjm47DP5EXIgrg1UlMSwJbBIdHyg1XS1E3OjQIDAQAB",
            "input": "{password}"
          }
        },
        {
          "id": "loginPost",
          "request": {
            "method": "POST",
            "url": "{loginUrl}",
            "headers": {
              "Referer": "{loginUrl}",
              "Accept": "text/html,application/xhtml+xml",
              "Accept-Language": "zh-CN,zh;q=0.9"
            },
            "contentType": "form",
            "form": {
              "username": "{username}",
              "password": "{encryptedPassword}",
              "captcha": "{captcha}",
              "execution": "{execution}",
              "_eventId": "submit",
              "loginType": "username",
              "system": "27A5A4DF0C874122A0AFE0367F0A3F46",
              "geolocation": ""
            }
          }
        }
      ],
      "outcome": {
        "captcha": {
          "bodyContains": ["验证码错误", "验证码不能为空", "请输入验证码"],
          "message": "验证码错误，请点按图片刷新后重试"
        },
        "rejected": {
          "bodyContains": ["用户名或密码错误", "账号或密码错误", "Invalid credentials"],
          "message": "账号或密码错误"
        },
        "success": {
          "finalUrlPrefixes": ["https://portal.cupk.edu.cn/portal/"]
        }
      }
    }
  },
  "monitor": {
    "coursePagePath": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME",
    "courseDataPathTemplate": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&semester={semesterId}",
    "gradeDataPathTemplate": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME",
    "examDataPathTemplate": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME",
    "semesterIdPatterns": ["cmd=([A-Z_]+)"],
    "studentIdPatterns": ["id=\"userName\"[^>]*>\\s*([^<\\s]+)"]
  },
  "groups": [
    {
      "title": "门户功能",
      "items": [
        {"title": "融合门户首页", "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME"},
        {"title": "服务大厅", "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=com.awspaas.user.apps.cupk.theme.v3_to_service_hall"}
      ]
    },
    {
      "title": "重绘测试",
      "items": [
        {"title": "门户概览", "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=schedule", "quick": true, "nativeType": "schedule"},
        {"title": "应用入口", "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=grade", "quick": true, "nativeType": "grade"},
        {"title": "网上服务", "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=exam", "quick": true, "nativeType": "exam"},
        {"title": "常用功能", "path": "https://portal.cupk.edu.cn/portal/r/w?cmd=CLIENT_USER_HOME&paView=program", "quick": true, "nativeType": "program"}
      ]
    }
  ],
  "readerConfig": {
    "scheduleProfiles": [
      {
        "locationPattern": "",
        "unitTimes": {
          "1": ["09:30", "10:15"],
          "2": ["10:20", "11:05"],
          "3": ["11:25", "12:10"]
        }
      }
    ]
  }
}
