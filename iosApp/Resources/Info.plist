<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>掌上教务</string>
	<key>CFBundleExecutable</key>
	<string>PalmAcademic</string>
	<key>CFBundleIdentifier</key>
	<string>cn.edu.cupk.portalreader.ios</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PalmAcademic</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.6</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<!--
	  DTPlatformVersion / DTSDKName / DTXcode are deliberately absent.

	  They used to be pinned to 16.5 here, which was accurate only for the Windows build and
	  became a lie the moment the macOS runner compiled the same target against a current SDK: the
	  bundle kept claiming iphoneos16.5 while the executable's LC_BUILD_VERSION said otherwise.
	  Anything reading the plist would draw the wrong conclusion, including the build report that
	  this repository publishes next to the artifact.

	  Nothing needs them to be set. Xcode derives all three from the toolchain in use when it
	  builds, and the Windows path has no use for them. The value that actually decides whether
	  the system draws Liquid Glass is the linked SDK recorded in the binary's LC_BUILD_VERSION
	  load command, which no Info.plist key can override.
	-->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv8</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>cn.edu.cupk.portalreader.poll.refresh</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!--
	  A university portal is very often reached over the campus network, where its host name
	  resolves to a private address. Since iOS 14 an app that touches such an address needs the
	  local-network permission, and without this key the system refuses the connection outright --
	  the request fails before a byte is sent, with no error the app can read. The symptom is a
	  page that loads forever on campus and works everywhere else, which is indistinguishable from
	  a broken reader.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>掌上教务需要访问学校教务系统。校园网内该系统解析为内网地址，未授权将无法加载课表、成绩与考试数据。</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<false/>
		</dict>
	</dict>
</dict>
</plist>
